# ─── Supabase: Main Platform ───────────────────────────────────
# Used by the frontend (src/lib/supabase.js) for ALL public pages:
# blog, projects, community, trading, testimonials, admin, etc.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Supabase: AI Assistant ────────────────────────────────────
# Used by backend APIs only (server.js, api/chat.js, api/leads.js, api/booking.js)
# Stores leads, chat conversations, and bookings separately.
VITE_AI_SUPABASE_URL=your_ai_assistant_supabase_url
VITE_AI_SUPABASE_SERVICE_ROLE_KEY=your_ai_assistant_service_role_key

# ─── Gemini API (replaces OpenAI) ──────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── Email (Resend — optional) ──────────────────────────────────
VITE_RESEND_API_KEY=your_resend_api_key
VITE_FROM_EMAIL=onboarding@resend.dev
VITE_ADMIN_EMAIL=your_email@example.com

# ─── WhatsApp (UltraMsg — optional) ─────────────────────────────
ULTRAMSG_INSTANCE_ID=your_instance_id
ULTRAMSG_TOKEN=your_ultramsg_token
OWNER_WHATSAPP=250794144738

# ─── API Server ─────────────────────────────────────────────────
API_PORT=3001
